#!/bin/bash
# 引导式【分级删除】一个会话。用法: cloud-delmenu <会话名>。由 cloudgo 选择器的 Ctrl-X 调用。
sess="${1:-}"
case "$sess" in ""|"➕"|"⟳"|"🔓") exit 0 ;; esac
printf '\n删除会话 \033[1m%s\033[0m —— 选删除级别:\n' "$sess"
printf '  \033[33m1)\033[0m 移出恢复体系  杀会话 + 移出登记/看板,【保留对话存档】,日后 ⟳ 可找回   ← 常用\n'
printf '  \033[31m2)\033[0m 彻底删除      连对话存档(.jsonl)一起删,【永久,不可恢复】\n'
printf '  3) 取消\n'
read -rp "选 (1/2/3): " c
case "$c" in
  1) cloud-forget "$sess" >/dev/null 2>&1
     printf '\033[32m✅ 已移出体系(对话存档留着,⟳ 可找回)\033[0m\n' ;;
  2) printf '\033[31m⚠️  彻底删除 %s,连对话一起没!\033[0m ' "$sess"
     read -rp "输 yes 确认: " y
     if [ "$y" = "yes" ]; then
       res=$(cc-sessions resolve "$sess" 2>/dev/null); uuid="${res##*$'\t'}"
       cloud-forget "$sess" >/dev/null 2>&1
       [ -n "$uuid" ] && [ "$uuid" != "$res" ] && find "$HOME/.claude/projects" -name "$uuid.jsonl" -delete 2>/dev/null
       printf '\033[31m✅ 已彻底删除(含对话存档)\033[0m\n'
     else printf '已取消\n'; fi ;;
  *) printf '已取消\n' ;;
esac
sleep 1.2
