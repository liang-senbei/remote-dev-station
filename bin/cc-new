#!/usr/bin/env bash
# cc-new <名称>  在 /opt/workspace/<名称> 开/续受管 Claude 会话。
export PATH="$HOME/.local/bin:$PATH"   # ssh 非交互调用时 sshd 只给极简 PATH,claude 在 ~/.local/bin 找不到 → pane 127 秒退
#   · 已在跑 → attach;有登记 → --resume 接回;全新 → 同步写登记表(不靠异步钩子)+ 钉死 --session-id。
#   登记进主账本 ~/.cloud-sessions/,cloud-watchdog 自愈、「恢复本页」可一键弹回。
name="$*"
[ -z "$name" ] && { echo "用法: cc-new <名称>"; exit 1; }
slug=$(printf '%s' "$name" | tr -s '[:space:]' '-' | tr -d '.:`"'"'" | sed 's/^-*//; s/-*$//')
[ -z "$slug" ] && slug="s$(date +%m%d%H%M%S)"
sess="cc-$slug"; dir="/opt/workspace/$slug"; mkdir -p "$dir"
python3 - "$dir" <<'PY' 2>/dev/null || true
import json,os,sys
p=os.path.expanduser("~/.claude.json")
try: d=json.load(open(p)) if os.path.exists(p) else {}
except Exception: d={}
if isinstance(d,dict):
    d.setdefault("projects",{}).setdefault(sys.argv[1],{})["hasTrustDialogAccepted"]=True
    json.dump(d,open(p,"w"))
PY
tmux has-session -t "$sess" 2>/dev/null && exec tmux attach -t "$sess"
CLOUD_MODEL=""; CLOUD_OPTS=""
eval "$(grep -m1 '^CLOUD_MODEL=' "$HOME/.bashrc" 2>/dev/null)"
# CLOUD_MODEL 为空 = 不传 --model,交给 ~/.claude/settings.json 的 ANTHROPIC_MODEL(座舱配置页管的那个)。
# 【不能】无脑拼 --model '$CLOUD_MODEL' —— 值为空时会传出 `--model ''`,claude 直接报错。
MODEL_ARG=""; [ -n "$CLOUD_MODEL" ] && MODEL_ARG="--model '$CLOUD_MODEL'"
eval "$(grep -m1 '^CLOUD_OPTS='  "$HOME/.bashrc" 2>/dev/null)"
mkdir -p "$HOME/.cloud-sessions"; reg="$HOME/.cloud-sessions/$sess.json"
uuid=""
[ -s "$reg" ] && uuid=$(python3 -c "import json,sys
try: print((json.load(open(sys.argv[1])) or {}).get('uuid',''))
except Exception: print('')" "$reg" 2>/dev/null)
if [ -n "$uuid" ]; then
  exec env -u TMUX tmux new-session -s "$sess" -e "CC_TAB=${CC_TAB:-}" \
    "cd '$dir' && IS_SANDBOX=1 claude $MODEL_ARG $CLOUD_OPTS --resume '$uuid' -n '$slug' --dangerously-skip-permissions"
fi
uuid=$(cat /proc/sys/kernel/random/uuid)
python3 -c "import json,sys,time;json.dump({'name':sys.argv[1],'dir':sys.argv[2],'uuid':sys.argv[3],'ts':time.time(),'src':'cc-new','ended':False,'tab':sys.argv[4]},open(sys.argv[5],'w'))" "$sess" "$dir" "$uuid" "${CC_TAB:-}" "$reg"
exec env -u TMUX tmux new-session -s "$sess" -e "CC_TAB=${CC_TAB:-}" \
  "cd '$dir' && IS_SANDBOX=1 claude $MODEL_ARG $CLOUD_OPTS --session-id '$uuid' -n '$slug' --dangerously-skip-permissions"
