<script>
const LBL={work:"运行中",input:"待输入",idle:"完成"};
function dur(s){if(s<60)return s+"秒";if(s<3600)return(s/60|0)+"分";return(s/3600|0)+"时"+((s%3600)/60|0)+"分"}
const tsel=document.getElementById('theme');
const savedT=localStorage.getItem('cc:theme')||'graphite';
document.documentElement.dataset.theme=savedT;tsel.value=savedT;
tsel.onchange=()=>{document.documentElement.dataset.theme=tsel.value;localStorage.setItem('cc:theme',tsel.value)};
let _sig='';
let _fs=parseFloat(localStorage.getItem('cc:fs'))||1;
function applyFs(){document.body.style.zoom=_fs}
function setFs(d){_fs=Math.max(0.7,Math.min(1.6,Math.round((_fs+d)*10)/10));localStorage.setItem('cc:fs',_fs);applyFs()}
applyFs();
let _cmp=localStorage.getItem('cc:compact')==='1';
function applyCmp(){document.body.classList.toggle('compact',_cmp);var b=document.getElementById('cmpbtn');if(b)b.style.color=_cmp?'var(--idle)':''}
function toggleCompact(){_cmp=!_cmp;localStorage.setItem('cc:compact',_cmp?'1':'0');applyCmp()}
applyCmp();
async function tick(){
 let d;try{d=await(await fetch('/api/sessions',{cache:'no-store'})).json()}catch(e){return}
 const ss=d.sessions||[];
 clock.textContent=new Date().toLocaleTimeString('zh-CN');
 const sig=ss.map(s=>s.key+'|'+s.state+'|'+s.detail+'|'+s.unread+'|'+s.toread+'|'+s.justDone).join('~');
 if(sig===_sig)return; _sig=sig;
 const c={work:0,input:0,idle:0};ss.forEach(s=>c[s.state]++);
