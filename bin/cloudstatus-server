#!/usr/bin/env python3
# cloudstatus-server — elegant always-on web dashboard for all cc-* Claude sessions.
# Serves a clean auto-refreshing card UI at / and JSON at /api/sessions.
# Bind: Tailscale IP only (consistent with the outbox/VNC services).
import http.server, socketserver, json, threading, time, subprocess, re, html, os

STATE_DIR = os.path.expanduser("~/.cloud-status")
READ_FILE = os.path.join(STATE_DIR, "_read.json")
_rlock = threading.Lock()
def load_read():
    try:
        with open(READ_FILE) as f: return json.load(f)
    except Exception: return {}
def save_read(d):
    with _rlock:
        try:
            with open(READ_FILE + ".tmp", "w") as f: json.dump(d, f, ensure_ascii=False)
            os.replace(READ_FILE + ".tmp", READ_FILE)
        except Exception: pass
def mark(key, seen=None, toread=None):
    d = load_read(); m = d.get(key, {})
    if seen is not None: m["seen"] = seen
    if toread is not None: m["toread"] = toread
    d[key] = m; save_read(d)
def read_hook(name):
    try:
        safe = re.sub(r"[^\w.\-]", "_", name)
        with open(os.path.join(STATE_DIR, safe + ".json")) as f:
            return json.load(f)
    except Exception:
        return None

HOST = "100.109.254.125"
PORT = 8722

WORK = re.compile(r"esc to interrupt", re.I)
# agent-teams / background work markers (no "esc to interrupt" line in this mode)
WORKMARK = re.compile(r"esc to interrupt|[◯⊙◐◑◒◓]|\b\d+\s+shells?\b|\d+\s*/\s*\d+\s*agents?\s+done|running…|working…|thinking…", re.I)
INPUT = re.compile(r"❯\s*\d+\.|\bDo you want\b|\(y/n\)|│\s*\d+\.\s|Yes, (and|proceed)|No, and tell|press enter to continue|Continue\?|to approve", re.I)
DONE = re.compile(r"[✻✽✺✶✷✸✹·*]\s*([A-Za-z][\w’'\- ]*?ed)\s+for\s+([0-9hms\. ]+)")
WORKLINE = re.compile(r"[✻✽✺✶✷✸✹·*◯⊙].*(esc to interrupt|agents?\s+done|background task)", re.I)
CHANGE_WINDOW = 8.0  # pane content moved within N seconds -> actively working

prev = {}; lastchange = {}; lasthash = {}; done_at = {}
SNAP = {"sessions": [], "ts": 0}

def sh(args):
    try: return subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL)
    except Exception: return ""

VOLATILE = re.compile(r"💰|🪟|⏳|⏵⏵|Opus 4|Sonnet 4|\(1M context\)|bypass permissions|for agents|shift\+tab|^[─-]+$|^❯\s*$")
def stable(c):
    # drop volatile status-chrome lines so an idle pane hashes constant (ignore ticking timers/cost)
    return "\n".join(l for l in c.splitlines() if not VOLATILE.search(l))

def classify(c, changed):
    tail = "\n".join([l for l in c.splitlines() if l.strip()][-45:])
    if INPUT.search(tail): return "input"
    if WORKMARK.search(tail): return "work"          # precise running markers
    if DONE.search(tail): return "idle"              # "✻ Xed for ..." = just completed
    if changed: return "work"                         # fallback: pane still moving, no done line
    return "idle"

def detail(c, st):
    lines = c.splitlines()
    if st == "work":
        for l in reversed(lines):
            if WORKLINE.search(l): return re.sub(r"\s+", " ", l.strip())[:80]
    if st == "input":
        for l in reversed(lines):
            if INPUT.search(l): return re.sub(r"\s+", " ", l.strip())[:80]
    for l in reversed(lines):
        if DONE.search(l): return re.sub(r"\s+", " ", l.strip())[:80]
    ne = [l for l in lines if l.strip()]
    return re.sub(r"\s+", " ", ne[-1].strip())[:80] if ne else ""

def scan():
    out = sh(["tmux", "list-sessions", "-F", "#{session_name}"])
    names = [s for s in out.splitlines() if s.startswith("cc-")]
    now = time.time()
    rd = load_read()
    import hashlib
    rows = []
    for s in names:
        hook = read_hook(s)
        if hook and hook.get("state"):
            # 有 hook 权威状态 -> 不抓屏(省下 capture-pane 子进程)
            hst = hook["state"]
            st = "idle" if hst in ("done", "idle") else ("input" if hst == "input" else "work")
            det = hook.get("detail", ""); ts_for = hook.get("ts", now); src = "hook"
        else:
            # 无 hook 数据的会话才回退到抓屏启发式
            c = sh(["tmux", "capture-pane", "-p", "-t", s])
            h = hashlib.md5(stable(c).encode("utf-8", "ignore")).hexdigest()
            if lasthash.get(s) != h:
                lasthash[s] = h; lastchange[s] = now
            changed = (now - lastchange.get(s, now)) < CHANGE_WINDOW
            st = classify(c, changed); det = detail(c, st); ts_for = lastchange.get(s, now); src = "term"
        if prev.get(s) == "work" and st == "idle":
            done_at[s] = now
        prev[s] = st
        meta = rd.get(s, {})
        seen = meta.get("seen", 0); toread = bool(meta.get("toread"))
        unread = (st == "idle") and (ts_for > seen + 0.5)
        rows.append({
            "key": s,
            "name": s[3:] if s.startswith("cc-") else s,
            "state": st,
            "detail": det,
            "idle": int(now - ts_for),
            "src": src,
            "unread": unread,
            "toread": toread,
            "justDone": bool(done_at.get(s) and (now - done_at[s]) < 45),
        })
    def rk(r):
        if r["toread"]: return 0
        if r["state"] == "input": return 1
        if r["state"] == "work": return 2
        if r["unread"]: return 3
        return 4
    rows.sort(key=lambda r: (rk(r), r["idle"]))
    SNAP["sessions"] = rows; SNAP["ts"] = now

def loop():
    while True:
        try: scan()
        except Exception: pass
        time.sleep(2)

