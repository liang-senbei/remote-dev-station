#!/usr/bin/env python3
"""cc-agents wrapper: 只保留 dir 落在 ROOTS 里的 agent，其余过滤掉。
供本机 cc 座舱(cc-cockpit)消费 —— Machine settings 的 ccCockpit.ccAgentsPath 指向本脚本。
原始 cc-agents 不动：终端里 `cc-agents`、cc-autopilot、通知，看到的仍是全部会话。

另外还负责【把转录硬链进座舱工作区的 project 目录】——见 link_transcripts()。

规则(2026-08-13 定)：座舱只扫 /opt/workspace 里的 agent，
/root/src 下的项目(站长自己的第二工作区)一律不进座舱。
座舱的「频道」是按 agent 的 dir 现算分组的，列表里没有 /root/src 的 agent，
频道里也就不会冒出 /root/src 的项目。
"""
import sys, os, re, json, glob, subprocess

ROOTS = ["/opt/workspace"]          # 只有这些根下面(含根本身)的 agent 才进座舱
REG   = os.path.expanduser("~/.cloud-sessions")   # 会话注册表:登记着每个会话【真正的启动目录】

def reg_dirs():
    """name -> 注册表登记的启动目录。

    ⚠️ 不能直接信 cc-agents 输出里的 dir:那个是【jsonl 落在哪个 project 目录】反推出来的
    (`decode_dir(dirname(jsonl))`),而座舱自己会把同一份 jsonl 软链进别的 project 目录
    (ensureSessionLinks,「打开」能 resume 就靠它)。软链一建,glob 可能先命中软链,
    一个 /root 的会话就会顶着 /opt/workspace/xxx 的 dir 混过过滤 —— 实测中过。
    注册表的 dir 是会话创建时写死的,不受软链影响,所以以它为准;
    没有注册表条目的裸会话再回落到 cc-agents 报的 dir(通常为空 → 直接滤掉)。"""
    out = {}
    for p in glob.glob(os.path.join(REG, "*.json")):
        try:
            r = json.load(open(p, encoding="utf-8"))
            if isinstance(r, dict) and r.get("name"):
                out[r["name"]] = r.get("dir", "") or ""
        except Exception:
            pass
    return out

REGD = reg_dirs()

def keep(a):
    d = REGD.get(a.get("name", ""), a.get("dir", "") or "")
    return any(d == r or d.startswith(r + "/") for r in ROOTS)

result = subprocess.run(
    ["/root/.local/bin/cc-agents", "--json"],
    capture_output=True, text=True, timeout=15,
)
if result.returncode != 0:
    sys.exit(result.returncode)

PROJECTS = os.path.expanduser("~/.claude/projects")


def enc_proj(p):
    """按 Claude Code 的规则把工作目录编码成 project 目录名：
    非 [A-Za-z0-9-] 的字符一律换成 '-'（'/'、'_'、'.' 和中文都算）。
    ⚠️ 座舱自己的 encProj 只换 [/_.]、不动非 ASCII，两边对中文目录会算出不同的名字；
    这里必须按 Claude Code 的规则来，因为最终是官方插件去那个目录里找转录。"""
    return re.sub(r"[^A-Za-z0-9-]", "-", p)


def link_transcripts(agents):
    """把每个 agent 的转录【硬链】进座舱工作区对应的 project 目录。

    为什么必须是硬链不是软链：官方插件枚举会话用
    `readdir(dir, {withFileTypes:true})` + `if (!ent.isFile()) continue`，
    而 Node 的 Dirent 走 lstat 语义 —— 软链的 isFile() 恒为 false，
    于是软链建了等于没建：插件找不到 uuid → activateSessionFromServer 失败
    → webview 发 restore_declined → 兜底开一个空白 Untitled 面板。
    (2026-09-03 实测，官方插件 2.1.258；座舱 ensureSessionLinks 用的就是 symlinkSync。)

    座舱是 `if (!lst) symlinkSync(...)` —— 只在目标不存在时才建。
    所以我们抢先把硬链摆好，它就不会再去建软链；已经是软链的这里顺手转成硬链。
    """
    for root in ROOTS:
        d = os.path.join(PROJECTS, enc_proj(root))
        try:
            os.makedirs(d, exist_ok=True)
            dev = os.stat(d).st_dev
        except OSError:
            continue
        for a in agents:
            uuid, src = a.get("uuid"), a.get("jsonl")
            if not uuid or not src:
                continue
            dst = os.path.join(d, uuid + ".jsonl")
            try:
                src = os.path.realpath(src)
                if not os.path.isfile(src) or os.stat(src).st_dev != dev:
                    continue        # 目标没了 / 跨文件系统 → 硬链建不了，别碰
                if os.path.lexists(dst):
                    st = os.lstat(dst)
                    if not os.path.islink(dst) and st.st_ino == os.stat(src).st_ino:
                        continue    # 已经是指向同一 inode 的硬链，什么都不用做
                    if not os.path.islink(dst) and st.st_nlink == 1:
                        continue    # 是独立真文件（插件自己建的），不许覆盖
                    os.unlink(dst)  # 软链 / 指错 inode 的旧硬链 → 重建
                os.link(src, dst)
            except OSError:
                pass                # 单个失败不能影响列表输出


data = json.loads(result.stdout)
kept = [a for a in data["agents"] if keep(a)]
link_transcripts(kept)
data["agents"] = kept
data["summary"]["total"] = len(kept)
data["summary"]["waiting"] = sum(1 for a in kept if a.get("attention") == "input")
data["summary"]["working"] = sum(1 for a in kept if a.get("attention") in ("work", "stalled"))
data["summary"]["done"] = sum(1 for a in kept if a.get("attention") == "done")
data["summary"]["idle"] = sum(1 for a in kept if a.get("attention") in ("idle", "ended"))
data["summary"]["tokens_today"] = sum(a.get("tokens_today", 0) for a in kept)
data["summary"]["cost_today_usd"] = round(sum(a.get("cost_today_usd", 0) for a in kept), 2)

print(json.dumps(data, ensure_ascii=False, indent=2))
