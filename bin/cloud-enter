#!/usr/bin/env bash
# cloud-enter —— 客户敲 `claude`(bashrc 里的 claude 函数调它)时,进/接回【当前目录】对应的受管会话。
#   cd 到不同项目目录再敲 claude = 不同会话(不同对话),就跟本地一样。
#   在跑 → attach;离线但有登记 → 连名带 uuid --resume(同名同 uuid);全新 → 新建。
#   claude 跑在 cc-* 的 tmux 里 + cc-state 钩子登记 → 断线/合盖重连接回、服务器重启 watchdog 自动 --resume。
#   带 IS_SANDBOX=1 绕 root 沙盒;用 `command claude` 避开 bashrc 的 claude 函数(防递归)。
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"   # 非交互 PATH 残缺,claude 在 ~/.local/bin,不加则 command not found(exit127)
dir="${CLOUD_DIR:-$PWD}"; case "$dir" in /|"") dir="$HOME";; esac   # 默认当前目录
name="${CLOUD_SESSION:-cc-$(basename "$dir")}"        # 会话名按目录:/opt/workspace/foo → cc-foo(cc- 前缀 → cc-state 登记 → watchdog 可 --resume)
# 会话模型:优先环境 → 取 ~/.bashrc 的 CLOUD_MODEL(与断电自愈同源) → 兜底
CLOUD_MODEL="${CLOUD_MODEL:-$(sed -n 's/^CLOUD_MODEL="\([^"]*\)".*/\1/p' "$HOME/.bashrc" 2>/dev/null | head -1)}"
CLOUD_MODEL="${CLOUD_MODEL:-}"   # 留空 = 不传 --model,交给 settings.json 的 ANTHROPIC_MODEL(座舱配置页管的那个);想临时指定仍可 CLOUD_MODEL=xxx cloud-enter
MODEL_ARG=""; [ -n "$CLOUD_MODEL" ] && MODEL_ARG="--model '$CLOUD_MODEL'"   # 命令行 --model 优先级高于 settings.json,所以为空时必须【整个参数都不出现】
CLOUD_OPTS="${CLOUD_OPTS:---effort max}"

# 已在 tmux 里 → 直接起 claude,不嵌套
if [ -n "$TMUX" ]; then cd "$dir" 2>/dev/null || cd "$HOME" || true; export IS_SANDBOX=1; exec "$(type -P claude)" ${CLOUD_MODEL:+--model "$CLOUD_MODEL"} $CLOUD_OPTS --dangerously-skip-permissions; fi

# 在跑 → attach
if tmux has-session -t "$name" 2>/dev/null; then exec env -u TMUX tmux attach -t "$name"; fi

# 离线但有登记 → 连名带 uuid --resume(目录还在才 resume,防死循环)
res=$(cc-sessions resolve "$name" 2>/dev/null); rdir="${res%%$'\t'*}"; uuid="${res##*$'\t'}"
if [ -n "$uuid" ] && [ "$rdir" != "$uuid" ] && [ -d "$rdir" ]; then
  exec env -u TMUX tmux new-session -s "$name" "cd '$rdir' && IS_SANDBOX=1 command claude $MODEL_ARG $CLOUD_OPTS --resume '$uuid' --dangerously-skip-permissions"
fi

# 全新
mkdir -p "$dir" 2>/dev/null
exec env -u TMUX tmux new-session -s "$name" "cd '$dir' && IS_SANDBOX=1 command claude $MODEL_ARG $CLOUD_OPTS --dangerously-skip-permissions"
