#!/usr/bin/env python3
# cc-agents-notify — agent 状态跃迁通知:
#   · 新进入 等你(input):Moshi 手机推送(带身份)+ 笔电语音念名字
#   · 新进入 完成(done):笔电语音念名字("老公,X的工作完成了")
#   语音用 cc-speak-laptop(edge-tts 甜美女声)。每个 agent 按名字稳定分到轮换池里一把嗓 → 听声辨人。
#   去重:~/.cloud-status/.notify-seen.json(键带 input:/done: 前缀;离开该态即清,再进再报)。
#   首次跑会"静默播种"当前态(只记不报),避免部署瞬间把 22 个全报一遍刷屏。
# 触发:Stop / Notification / PermissionRequest hook(async)。
#   cc-agents-notify          正常       --dry 只打印     --test Moshi测试    --voice-test 语音测试
import os, sys, json, subprocess, time, hashlib

STATUS  = os.path.expanduser("~/.cloud-status")
SEEN    = os.path.join(STATUS, ".notify-seen.json")
VOICES_FILE = os.path.expanduser("~/.cloud-tts-voices.txt")
FISH_VOICES_FILE = os.path.expanduser("~/.cloud-tts-fish-voices.txt")
CONF    = os.path.expanduser("~/.cloud-tts.conf")
ASSIGN_FILE = os.path.expanduser("~/.cloud-tts-assign.txt")
def _moshi_token():
    # 客户填自己的 Moshi 推送 token:环境变量 MOSHI_TOKEN 优先,其次 ~/.cloud-moshi.conf / ~/.cloud-tts.conf 里的 `MOSHI_TOKEN=`;都没有=不推送(静默)
    t = os.environ.get("MOSHI_TOKEN", "").strip()
    if t: return t
    for cf in (os.path.expanduser("~/.cloud-moshi.conf"), CONF):
        try:
            for l in open(cf):
                l = l.strip()
                if l.startswith("MOSHI_TOKEN="): return l.split("=", 1)[1].strip().strip('"')
        except Exception: pass
    return ""
TOKEN   = _moshi_token()
WEBHOOK = os.environ.get("MOSHI_WEBHOOK", "https://api.getmoshi.app/api/webhook")
SPEAK   = os.environ.get("CC_SPEAK", "cc-speak-laptop")   # 走 PATH;缺了(客户无笔电语音)则 speak_one 静默跳过,不影响手机推送
DEFAULT_VOICES = ["zh-CN-XiaoyiNeural","zh-CN-XiaoxiaoNeural","zh-TW-HsiaoYuNeural","zh-TW-HsiaoChenNeural"]

def push(title, msg):
    if not TOKEN: return   # 未配 Moshi token(客户未填)→ 不推送,静默跳过
    try:
        subprocess.run(["curl","-s","-X","POST",WEBHOOK,"-H","Content-Type: application/json",
            "-d", json.dumps({"token":TOKEN,"title":title,"message":msg}, ensure_ascii=False)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
    except Exception:
        pass

def _backend():
    try:
        for l in open(CONF):
            l = l.strip()
            if l.startswith("TTS_BACKEND="): return l.split("=", 1)[1].strip()
    except Exception: pass
    return "edge"

def _readpool(path):
    try:
        return [l.strip().split("|")[0] for l in open(path) if l.strip() and not l.lstrip().startswith("#")]
    except Exception: return []

def pool():                                  # 返回 (嗓列表, 是否 fish)
    if _backend() == "fish":
        vs = _readpool(FISH_VOICES_FILE)
        if vs: return vs, True
    vs = _readpool(VOICES_FILE)
    return (vs or DEFAULT_VOICES), False

def _lines(path):
    try: return [l.strip() for l in open(path) if l.strip() and not l.lstrip().startswith("#")]
    except Exception: return []

def _fish_label2rid():                        # 显示名 → reference_id(供钦定表按名字指嗓)
    m = {}
    for l in _lines(FISH_VOICES_FILE):
        p = l.split("|")
        if len(p) >= 2: m[p[1].strip()] = p[0].strip()
    return m

def _assign_map():                            # ~/.cloud-tts-assign.txt: "agent = 嗓显示名"
    m = {}
    for l in _lines(ASSIGN_FILE):
        if "=" in l:
            a, v = l.split("=", 1); m[a.strip()] = v.strip()
    return m

def voice_for(name):                         # 先查钦定表,没命中再按名字哈希稳定分
    vs, is_fish = pool()
    if is_fish:
        lbl = _assign_map().get(name)
        if lbl:
            rid = _fish_label2rid().get(lbl)
            if rid: return rid, True
    h = int(hashlib.md5(name.encode("utf-8")).hexdigest(), 16)
    return vs[h % len(vs)], is_fish

def speak_one(text, voice, is_fish):
    env = os.environ.copy()
    if is_fish: env["FISH_VOICE_ID"] = voice
    else:       env["CC_TTS_VOICE"] = voice
    try:
        subprocess.run([SPEAK, text], env=env, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=40)
    except Exception:
        pass

def short(nm):                               # 念名字去掉 cc- 前缀更顺口
    return nm[3:] if nm.startswith("cc-") else nm

def agents():
    try:
        out = subprocess.check_output(["cc-agents","--json"],
              text=True, stderr=subprocess.DEVNULL, timeout=8)
        return json.loads(out).get("agents", [])
    except Exception:
        return []

def load_seen():
    try: return json.load(open(SEEN))
    except Exception: return {}
def save_seen(s):
    try:
        tmp = SEEN + ".tmp"; json.dump(s, open(tmp,"w")); os.replace(tmp, SEEN)
    except Exception: pass

def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--test":
        push("🔔 指挥中心测试", "cc-agents-notify 通了,手机能收到就 OK。")
        print("已发测试推送。"); return
    if arg == "--voice-test":
        for nm in ["cc-牢大","cc-投资","cc-灰色"]:
            v, isf = voice_for(nm); speak_one(f"老公,{short(nm)}的工作完成了", v, isf)
        print("已发语音测试(听笔电,3 个 agent 各自的嗓)。"); return
    dry = (arg == "--dry")

    ags = agents()
    cur = {}
    for a in ags:
        att = a.get("attention")
        nm  = a.get("name") or a.get("uuid")
        if not nm: continue
        if att == "input":  cur["input:"+nm] = a
        elif att == "done": cur["done:"+nm]  = a

    seen = load_seen()
    if not any(":" in k for k in seen):       # 首次跑新格式 → 静默播种,不报
        if not dry: save_seen({k: time.time() for k in cur})
        print("首次:已静默播种当前状态(只记不报)。"); return

    new_push, done_names, input_names = [], [], []
    for k, a in cur.items():
        if k in seen: continue
        nm = a.get("name","?")
        if k.startswith("input:"):
            repo=a.get("repo","-"); br=a.get("branch","-"); task=(a.get("task","") or "")[:50]
            new_push.append((f"🟥 {nm} 等你", f"{repo}@{br} · {task} · 进入: tmux attach -t {nm}"))
            input_names.append(nm)
        else:
            done_names.append(nm)
        seen[k] = time.time()
    for k in list(seen.keys()):
        if k not in cur: del seen[k]

    if dry:
        for t,m in new_push: print("[DRY] PUSH:", t, "|", m)
        for nm in done_names:  print(f"[DRY] SAY[{voice_for(nm)[0]}]: 老公,{short(nm)}的工作完成了")
        for nm in input_names: print(f"[DRY] SAY[{voice_for(nm)[0]}]: 老公,{short(nm)}在等你授权")
        print("当前关注:", list(cur.keys()) or "无"); return

    for t,m in new_push: push(t, m)
    for nm in done_names:
        v, isf = voice_for(nm); speak_one(f"老公,{short(nm)}的工作完成了", v, isf)
    for nm in input_names:
        v, isf = voice_for(nm); speak_one(f"老公,{short(nm)}在等你授权", v, isf)
    save_seen(seen)

if __name__ == "__main__":
    main()
