#!/usr/bin/env bash
# 自动清理"过时"tmux 会话:未 attach 且空闲(无活动)超过阈值分钟。
# 对话存档(~/.claude/projects/*.jsonl)不删,随时 claude --resume 找回。
export PATH="$HOME/.local/bin:$PATH"   # 让 cloud-forget 可寻(systemd 环境 PATH 精简)
THRESHOLD_MIN=${1:-180}
log=/var/log/cc-reap.log
now=$(date +%s)
tmux ls -F '#{session_name}|#{session_attached}|#{session_activity}' 2>/dev/null | while IFS='|' read -r name att act; do
  [ "$att" = "1" ] && continue
  [ -z "$act" ] && continue
  idle=$(( (now - act) / 60 ))
  if (( idle >= THRESHOLD_MIN )); then
    if tmux kill-session -t "$name" 2>/dev/null; then
      command -v cloud-forget >/dev/null 2>&1 && cloud-forget "$name" >/dev/null 2>&1   # 摘登记!否则 cloud-watchdog(每15s)把它当"该活却离线"又 --resume 拉回=白杀+抖动(对话 jsonl 仍在,可 cloud_resume 找回)
      echo "$(date '+%F %T') reaped $name (idle ${idle}m, threshold ${THRESHOLD_MIN}m)" >> "$log"
    fi
  fi
done
