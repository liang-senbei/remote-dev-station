#!/bin/bash
# 一键切换 Wave 整套主题(终端 + 画框 + 边栏 + 文字 联动)——改全局 term:theme。
# 用法: wavetheme [主题名]   无参数 = 弹菜单选
THEMES="tokyo-night nord catppuccin-mocha gruvbox-dark rose-pine one-half-dark solarized-dark solarized-light catppuccin-latte"

set_theme() {
  local t="$1" d f
  for d in waveterm waveterm-dev; do
    f="$HOME/.config/$d/settings.json"
    [ -f "$f" ] && python3 -c "import json;p='$f';c=json.load(open(p));c['term:theme']='$t';json.dump(c,open(p,'w'),ensure_ascii=False,indent=2)"
  done
  # 在 Wave 块里有 wsh → 让它立刻热生效;没有也没关系,Wave 会热加载 settings.json
  command -v wsh >/dev/null 2>&1 && wsh setconfig "term:theme=$t" >/dev/null 2>&1
  printf '\033[32m✅ 已切到「%s」——终端/画框/边栏/文字 整套联动。\033[0m\n' "$t"
  printf '   (若界面没立刻变:点一下别的标签再点回来,或重开 Wave。)\n'
}

# 带参数:直接切
if [ -n "$1" ]; then set_theme "$1"; exit 0; fi

# 无参数:菜单
echo "选一个主题(整套 UI 联动,前 6 个深色 / 后 3 个浅色):"
PS3="输入序号 ↵ : "
select t in $THEMES "取消"; do
  [ "$t" = "取消" ] && { echo "已取消"; exit 0; }
  if [ -n "$t" ]; then set_theme "$t"; break; fi
  echo "序号无效,重选"
done
