#!/bin/bash
# 一键切换 Wave 整套主题(终端+画框+边栏+文字+图标联动)。用法: wavetheme [主题名];无参=菜单(浅色在前)。
# 主题列表从"联动主题文件"(popular+light)派生,以后加主题不用改这里。
list_themes() {
  python3 -c "import json,os
d={}
for f in ('popular-themes.json','light-themes.json'):
    p=os.path.expanduser('~/.config/waveterm/termthemes/'+f)
    if os.path.exists(p):
        try: d.update(json.load(open(p)))
        except Exception: pass
def lum(n):
    h=(d[n].get('background','#000000')).lstrip('#')
    try: return -(0.299*int(h[0:2],16)+0.587*int(h[2:4],16)+0.114*int(h[4:6],16))
    except Exception: return 0.0
print('\n'.join(sorted(d,key=lum)))" 2>/dev/null
}
set_theme() {
  local t="$1" d f
  for d in waveterm waveterm-dev; do
    f="$HOME/.config/$d/settings.json"
    [ -f "$f" ] && python3 -c "import json;p='$f';c=json.load(open(p));c['term:theme']='$t';json.dump(c,open(p,'w'),ensure_ascii=False,indent=2)"
  done
  command -v wsh >/dev/null 2>&1 && wsh setconfig "term:theme=$t" >/dev/null 2>&1
  printf '\033[32m✅ 已切到「%s」(整套联动)。没立刻变就点下别的标签再回来 / 重开 Wave。\033[0m\n' "$t"
}
if [ -n "$1" ]; then set_theme "$1"; exit 0; fi
echo "选主题(浅色在前):"
PS3="输入序号 ↵ : "
select t in $(list_themes) "取消"; do
  [ "$t" = "取消" ] && { echo "已取消"; exit 0; }
  [ -n "$t" ] && { set_theme "$t"; break; }
  echo "序号无效,重选"
done
