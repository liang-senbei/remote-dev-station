#!/bin/bash
# 韧性连接 Wave 会话:mosh 到云服务器跑指定命令。
#  · 干净退出(detach / 菜单 Esc / claude 正常退出 → 退出码 0)→ 不重连,标签干净结束。
#    (修 HIGH:以前无脑 5 秒重连,detach 会被弹回同一会话、退不出去。)
#  · 真断线(非 0:服务器没了/连接错)→ 5 秒自动重连(Ctrl-C 取消)。
TARGET="${*:-cloudgo}"; HOST="root@100.109.254.125"; MOSH="/opt/homebrew/bin/mosh"
bid="${WAVETERM_BLOCKID:-}"; case "$bid" in *[!0-9a-fA-F-]*) bid= ;; esac   # M5:白名单 blockid,挡 shell 注入
while true; do
  "$MOSH" "$HOST" -- bash -ic "WAVETERM_BLOCKID='$bid'; $TARGET"
  ec=$?
  if [ "$ec" -eq 0 ]; then
    printf "\n\033[32m── 已退出会话(此标签可关;重开会自动回到它)──\033[0m\n"; break
  fi
  printf "\n\033[33m── 连接断开(码 %s)。5 秒后自动重连,Ctrl-C 取消 ──\033[0m\n" "$ec"
  sleep 5 || break
done
