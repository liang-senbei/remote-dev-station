[Unit]
Description=Project dashboards portal — serves ONLY /root/inbox/dashboards on :8088 (项目看板门户)
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -m http.server 8088 --bind 100.109.254.125 --directory /root/inbox/dashboards
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
