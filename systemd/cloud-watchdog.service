[Unit]
Description=Reconcile/auto-resurrect dead Claude sessions (watchdog)
After=cloud-sessions.service

[Service]
Type=oneshot
# KillMode=process:oneshot 退出时只杀主进程,不回收 cgroup 里 fork 出的 tmux 服务器。
# 缺它(默认 control-group)→ 复活的会话随 oneshot 结束被连带杀掉,断电自愈失效。
KillMode=process
TimeoutStartSec=120
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
# CLOUD_MODEL 不再写死:留空则 watchdog 拉回会话时不传 --model,
# 由 ~/.claude/settings.json 的 ANTHROPIC_MODEL 决定(cc 座舱「配置」页管的就是它)。
# 要把自愈钉死在某个模型上,取消下面这行的注释即可。
#Environment="CLOUD_MODEL=claude-opus-4-8[1m]"
Environment="CLOUD_OPTS=--effort max"
Environment=DISABLE_AUTOUPDATER=1
ExecStart=/root/.local/bin/cloud-watchdog
