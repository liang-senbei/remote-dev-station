# → /etc/default/earlyoom
# earlyoom：可用 RAM <10% 就主动 SIGTERM/KILL "最肥的 claude"，不等内核硬 OOM
# （硬 OOM 常在机器已卡死后才开枪、还可能误杀 ssh/tmux 连累整机）。
# -s 100 = 只看 RAM 不等 swap 见底（直击 RAM 暴涨型 OOM）；--prefer claude + --avoid 保住 ssh/tmux/systemd。
# 被杀会话由 cloud-watchdog 每 15s 自动 --resume 拉回（内存够了才拉）。
EARLYOOM_ARGS="-r 60 -m 10 -s 100 --prefer '^claude$' --avoid '(^sshd$|^systemd|^init$|dbus-daemon|tmux)'"
