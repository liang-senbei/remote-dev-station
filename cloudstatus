#!/usr/bin/env python3
# cloudstatus — live status board for all cc-* Claude sessions in tmux.
# States: 运行中 (esc to interrupt) / 待输入 (permission/options) / 已完成空闲.
# Flags 刚完成 when a session transitions 运行中 -> 空闲. Usage: cloudstatus [--once]
import subprocess, time, re, sys, hashlib

REFRESH = 2.0
WORK = re.compile(r"esc to interrupt", re.I)
INPUT = re.compile(r"❯\s*\d+\.|\bDo you want\b|\(y/n\)|\by/n\b|│\s*\d+\.\s|Yes, (and|proceed)|No, and tell|press enter to continue|Continue\?", re.I)
DONE = re.compile(r"[✻✽✺✶✷✸✹·*]\s*([A-Za-z][\w’'\- ]*?ed)\s+for\s+([0-9hms\. ]+)")
WORKLINE = re.compile(r"[✻✽✺✶✷✸✹·*].*esc to interrupt", re.I)

C = {"r":"\033[0m","g":"\033[32m","y":"\033[33m","b":"\033[36m","dim":"\033[2m","bold":"\033[1m","red":"\033[31m","grn_bg":"\033[42;30m"}

def sessions():
    try:
        out = subprocess.check_output(["tmux","list-sessions","-F","#{session_name}"], text=True, stderr=subprocess.DEVNULL)
        return [s for s in out.splitlines() if s.startswith("cc-")]
    except Exception:
        return []

def cap(s):
    try:
        return subprocess.check_output(["tmux","capture-pane","-p","-t",s], text=True, stderr=subprocess.DEVNULL)
    except Exception:
        return ""

def classify(c):
    tail = "\n".join([l for l in c.splitlines() if l.strip()][-45:])
    if WORK.search(tail): return "work"
    if INPUT.search(tail): return "input"
    return "idle"

def detail(c, st):
    lines = c.splitlines()
    if st == "work":
        for l in reversed(lines):
            if WORKLINE.search(l): return re.sub(r"\s+"," ",l.strip())[:58]
    if st == "input":
        for l in reversed(lines):
            if INPUT.search(l): return re.sub(r"\s+"," ",l.strip())[:58]
    for l in reversed(lines):
        if DONE.search(l): return re.sub(r"\s+"," ",l.strip())[:58]
    ne = [l for l in lines if l.strip()]
    return re.sub(r"\s+"," ",ne[-1].strip())[:58] if ne else ""

def fmt_dur(sec):
    sec = int(sec)
    if sec < 60: return f"{sec}秒"
    if sec < 3600: return f"{sec//60}分{sec%60}秒"
    return f"{sec//3600}时{(sec%3600)//60}分"

prev = {}; lastchange = {}; lasthash = {}; done_at = {}

def render(once=False):
    now = time.time()
    ss = sessions()
    rows = []
    n_work = n_input = n_idle = 0
    for s in ss:
        c = cap(s); st = classify(c)
        h = hashlib.md5(c.encode("utf-8","ignore")).hexdigest()
        if lasthash.get(s) != h: lasthash[s] = h; lastchange[s] = now
        if prev.get(s) == "work" and st == "idle": done_at[s] = now
        prev[s] = st
        idle = now - lastchange.get(s, now)
        rows.append((s, st, idle, detail(c, st), done_at.get(s, 0)))
        n_work += st=="work"; n_input += st=="input"; n_idle += st=="idle"
    # sort: input first (need you), then work, then idle
    rank = {"input":0,"work":1,"idle":2}
    rows.sort(key=lambda r: (rank[r[1]], -r[4]))
    buf = []
    buf.append(f"{C['bold']}会话状态板{C['r']}  {time.strftime('%H:%M:%S')}   "
               f"{C['y']}待输入 {n_input}{C['r']} · {C['b']}运行中 {n_work}{C['r']} · {C['g']}空闲 {n_idle}{C['r']}  (共{len(ss)})")
    buf.append("─" * 78)
    for s, st, idle, det, da in rows:
        name = s[3:] if s.startswith("cc-") else s
        name = name[:24].ljust(24)
        if st == "work":
            tag = f"{C['b']}🔵 运行中{C['r']}"; extra = ""
        elif st == "input":
            tag = f"{C['y']}🟡 待输入{C['r']}"; extra = f" {C['y']}← 需要你{C['r']}"
        else:
            recent = (time.time() - da) < 45 if da else False
            tag = f"{C['g']}🟢 完成 {C['r']}" + (f"{C['grn_bg']} 刚完成✅ {C['r']}" if recent else "")
            extra = f"  {C['dim']}空闲 {fmt_dur(idle)}{C['r']}"
        buf.append(f"{tag}  {C['bold']}{name}{C['r']} {C['dim']}{det}{C['r']}{extra}")
    if not rows:
        buf.append(f"{C['dim']}(无 cc-* 会话){C['r']}")
    out = "\n".join(buf)
    if once:
        print(out)
    else:
        sys.stdout.write("\033[2J\033[H" + out + "\n")
        sys.stdout.flush()

if "--once" in sys.argv:
    render(once=True)
else:
    try:
        while True:
            render(); time.sleep(REFRESH)
    except KeyboardInterrupt:
        pass
