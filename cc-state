#!/usr/bin/env python3
# cc-state — 会话恢复登记器(由 Claude Code 生命周期钩子驱动)。
# 每个钩子把事件 JSON 从 stdin 传入;据此维护"按会话恢复登记表"
#   ~/.cloud-sessions/<tmux会话名>.json = {name, dir, uuid, ts, src, ended}
# 供 cloud-watchdog 在重启/崩溃后连名带对话 `claude --resume <uuid>` 拉回。
# (注:原先还写 ~/.cloud-status 给 DIY 网页看板 :8722——看板 2026-06 已下线,那半边已移除。)
import sys, os, json, time, subprocess, re

def tmux_session():
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        return ""
    try:
        return subprocess.check_output(["tmux", "display", "-p", "-t", pane, "#{session_name}"],
                                       text=True, stderr=subprocess.DEVNULL).strip()
    except Exception:
        return ""

raw = ""
try:
    if not sys.stdin.isatty():
        raw = sys.stdin.read()
except Exception:
    pass
try:
    data = json.loads(raw) if raw.strip() else {}
except Exception:
    data = {}

ev = data.get("hook_event_name") or (sys.argv[1] if len(sys.argv) > 1 else "")
tmux_name = tmux_session()

# 临时会话(cc-tmp-*):不登记 → 不进恢复系统(对话 jsonl 仍由 claude 自己保留)
if tmux_name.startswith("cc-tmp-"):
    sys.exit(0)

# ---- 按会话恢复登记表 (name↔dir↔uuid) ----
# SessionEnd(主动 /exit)→ ended=True:watchdog 不再自动复活(免得主动退的被拉回),仍可手动 cloud_resume 找回。
# 其它事件 → ended=False 重新激活。只在能拿到 tmux 会话名时登记。
if tmux_name and tmux_name != "unknown":
    REG = os.path.expanduser("~/.cloud-sessions")
    try:
        os.makedirs(REG, exist_ok=True)
        rpath = os.path.join(REG, re.sub(r"[^\w.\-]", "_", tmux_name) + ".json")
        uuid = data.get("session_id", "") or ""
        cwd = data.get("cwd") or os.getcwd()
        if not uuid and os.path.exists(rpath):          # 本次事件没带 session_id → 保留旧 uuid
            try: uuid = (json.load(open(rpath)) or {}).get("uuid", "") or ""
            except Exception: uuid = ""
        rec = {"name": tmux_name, "dir": cwd, "uuid": uuid, "ts": time.time(),
               "src": "hook", "ended": (ev == "SessionEnd")}
        tmp = rpath + ".tmp"
        with open(tmp, "w") as f:
            json.dump(rec, f, ensure_ascii=False)
        os.replace(tmp, rpath)
    except Exception:
        pass
