# 复制为 ~/.cloud-tts.conf,填自己的值 —— cc-agents-notify(手机推送)/ cc-speak-laptop(笔电语音)读取。

# ── 手机推送(Moshi):有 agent 进入「等你授权 / 完成」时推到你手机 ──
# 去 getmoshi.app 拿你的 webhook token 填这里;留空 = 不推送。也可用环境变量 MOSHI_TOKEN 覆盖。
MOSHI_TOKEN=

# ── 笔电语音(可选):缺 cc-speak-laptop / 客户无笔电语音时自动跳过,不影响手机推送 ──
# TTS_BACKEND=edge  免费本地 edge-tts(默认,无需 key)
# TTS_BACKEND=fish  Fish Audio(更自然中文,需下面 key;失败自动回退 edge)
TTS_BACKEND=edge

# 用 Fish 才需要:去 fish.audio 注册(免费)拿 API key,并把上面改成 fish
FISH_API_KEY=
FISH_VOICE_ID=
